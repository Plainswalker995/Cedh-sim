+    /** A short list: the pilot's combo lines, the big spells, the answers and the winning blow. */
+    static List<String> keyPlays(final List<GameLogEntry> log, final List<String> journal) {
+        final List<String> out = new ArrayList<>();
+        for (final String j : journal) {
+            if (j.contains("LINE") || j.contains("WIN")) {
+                out.add("pilot: " + j);
+            }
+        }
+        final Set<String> keyCards = new HashSet<>(Arrays.asList("Thassa's Oracle", "Demonic Consultation",
+                "Tainted Pact", "Underworld Breach", "Ad Nauseam", "Brain Freeze", "Laboratory Maniac",
+                "Jace, Wielder of Mysteries", "Doomsday", "Necropotence", "Displacer Kitten", "Dramatic Reversal",
+                "Isochron Scepter", "Food Chain", "Kinnan, Bonder Prodigy", "Basalt Monolith", "Walking Ballista",
+                "Dualcaster Mage", "Twinflame", "Heliod, Sun-Crowned", "Grindstone", "Painter's Servant",
+                "Hermit Druid", "Protean Hulk", "Flash", "Mnemonic Betrayal", "Wheel of Fortune", "Timetwister",
+                "Lion's Eye Diamond", "Bolas's Citadel", "Aetherflux Reservoir", "Demonic Tutor", "Vampiric Tutor",
+                "Imperial Seal", "Rhystic Study", "Mystic Remora", "Natural Order", "Finale of Devastation",
+                "Dockside Extortionist", "Birgi, God of Storytelling", "Tymna the Weaver", "Kraum, Ludevic's Opus"));
+        final Set<String> answers = new HashSet<>(Arrays.asList("Force of Will", "Force of Negation", "Pact of Negation",
+                "Fierce Guardianship", "Mental Misstep", "Flusterstorm", "Swan Song", "Mindbreak Trap",
+                "Red Elemental Blast", "Pyroblast", "Deflecting Swat", "Silence", "Orim's Chant", "Mana Tithe",
+                "Counterspell", "Mana Drain", "Spell Pierce", "An Offer You Can't Refuse", "Stern Scolding",
+                "Veil of Summer", "Dispel", "Snapback", "Abeyance", "Swords to Plowshares", "Path to Exile",
+                "Cyclonic Rift", "Chain of Vapor", "Strix Serenade", "Drannith Magistrate", "Opposition Agent",
+                "Collector Ouphe", "Rule of Law", "Damping Sphere", "Trinisphere", "Cursed Totem"));
+        String turn = "";
+        for (final GameLogEntry e : log) {
+            final String m = e.message();
+            if (e.type() == GameLogEntryType.TURN) {
+                turn = m.replaceAll("^Turn (\\d+).*$", "T$1");
+                continue;
+            }
+            if (e.type() == GameLogEntryType.GAME_OUTCOME && m.contains("has won")) {
+                out.add("End: " + m);
+                continue;
+            }
+            if (e.type() != GameLogEntryType.STACK_ADD) {
+                continue;
+            }
+            final Matcher mm = CAST.matcher(m);
+            if (!mm.matches()) {
+                continue;
+            }
+            final String card = mm.group(2).replaceAll(" \\(\\d+\\)$", "");
+            if (keyCards.contains(card) || answers.contains(card)) {
+                out.add(turn + ": " + m);
+            }
+        }
+        return out.size() > 30 ? out.subList(out.size() - 30, out.size()) : out;
+    }
+
+    private static Map<String, List<String>> parse(final String[] args) {
+        final Map<String, List<String>> params = new HashMap<>();
+        List<String> cur = null;
+        for (int i = 1; i < args.length; i++) {
+            final String a = args[i];
+            if (a.startsWith("-") && a.length() > 1 && !Character.isDigit(a.charAt(1))) {
+                cur = new ArrayList<>();
+                params.put(a.substring(1), cur);
+            } else if (cur != null) {
+                cur.add(a);
+            }
+        }
+        return params;
+    }
+}
