diff --git a/forge-ai/src/main/java/forge/ai/simulation/CedhPilot.java b/forge-ai/src/main/java/forge/ai/simulation/CedhPilot.java
new file mode 100644
index 00000000..8b64bbdb
--- /dev/null
+++ b/forge-ai/src/main/java/forge/ai/simulation/CedhPilot.java
@@ -0,0 +1,525 @@
+package forge.ai.simulation;
+
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.List;
+import java.util.Map;
+import java.util.WeakHashMap;
+
+import forge.ai.ComputerUtilCost;
+import forge.game.Game;
+import forge.game.card.Card;
+import forge.game.phase.PhaseHandler;
+import forge.game.phase.PhaseType;
+import forge.game.player.Player;
+import forge.game.spellability.SpellAbility;
+import forge.game.spellability.SpellAbilityStackInstance;
+import forge.game.zone.ZoneType;
+
+/**
+ * cEDH pilot layer: deterministic lines for the fast wins of competitive Commander, checked before the general AI
+ * picks a play, plus a journal of what the pilot tried (shown in the play-by-play).
+ */
+public final class CedhPilot {
+    private CedhPilot() { }
+
+    /** Switched on by the cEDH simulator; off, Forge plays as it always has. */
+    public static volatile boolean enabled = false;
+
+    /**
+     * Human imperfection: the chance, at each decision where a sure winning line is on, that the pilot does not see
+     * it this time (it may still find it with the general search, or on its next priority). 0 for pure-strength tests.
+     */
+    public static volatile double imperfection = 0.0;
+
+    /** Whether the pilot overlooks the sure lines at this decision. Drawn from the game's seeded random source. */
+    public static boolean slips(final Player ai) {
+        if (!enabled || imperfection <= 0 || ai == null) {
+            return false;
+        }
+        return forge.util.MyRandom.getRandom().nextDouble() < imperfection;
+    }
+
+    /** Fast mana the pilot puts down at once: mana rocks of mana value 0 to 2 that need nothing else to work. */
+    private static boolean isFastMana(final Card c) {
+        if (c == null || !c.isArtifact() || c.isCreature() || c.getCMC() > 2 || c.getManaAbilities().isEmpty()) {
+            return false;
+        }
+        final String n = c.getName();
+        // these are combo pieces or need a plan (Lion's Eye Diamond, Lotus Petal are spent, not deployed)
+        return !n.equals("Lion's Eye Diamond") && !n.equals("Lotus Petal") && !n.equals("Mox Diamond")
+                && !n.equals("Chrome Mox") && !n.equals("Jeweled Lotus");
+    }
+
+    /**
+     * The opening habits of cEDH players, before the general AI decides: in your own main phase with an empty stack,
+     * deploy free and cheap mana rocks, then cast the commander(s) as soon as they can be paid for.
+     */
+    public static SpellAbility sureCast(final Player ai, final List<SpellAbility> candidates) {
+        if (!enabled || ai == null || candidates == null || candidates.isEmpty()) {
+            return null;
+        }
+        final Game game = ai.getGame();
+        final PhaseHandler ph = game.getPhaseHandler();
+        if (!ph.isPlayerTurn(ai) || !game.getStack().isEmpty() || !(ph.is(PhaseType.MAIN1) || ph.is(PhaseType.MAIN2))) {
+            return null;
+        }
+        final SpellAbility tutor = tutorForOracle(ai, candidates);
+        if (tutor != null) {
+            return tutor;
+        }
+        final SpellAbility breach = breachLine(ai, candidates);
+        if (breach != null) {
+            return breach;
+        }
+        SpellAbility rock = null;
+        SpellAbility engine = null;
+        SpellAbility commander = null;
+        for (final SpellAbility sa : candidates) {
+            final Card host = sa == null ? null : sa.getHostCard();
+            if (host == null || !sa.isSpell() || !ai.equals(host.getController()) && !ai.equals(host.getOwner())) {
+                continue;
+            }
+            if (host.isInZone(ZoneType.Hand) && isFastMana(host)) {
+                if (rock == null || host.getCMC() < rock.getHostCard().getCMC()) {
+                    if (playable(ai, sa)) {
+                        rock = sa;
+                    }
+                }
+            } else if (host.isInZone(ZoneType.Hand) && ENGINES.contains(host.getName()) && !controls(ai, host.getName())
+                    && (!"Mystic Remora".equals(host.getName()) || game.getPhaseHandler().getTurn() <= 16)) {
+                if (engine == null && playable(ai, sa)) {
+                    engine = sa;
+                }
+            } else if (host.isCommander() && host.isInZone(ZoneType.Command) && !host.isLand()) {
+                if ((commander == null || host.getCMC() < commander.getHostCard().getCMC()) && playable(ai, sa)) {
+                    commander = sa;
+                }
+            }
+        }
+        if (rock != null) {
+            note(game, "PLAN " + ai.getName() + " deploys fast mana: " + rock.getHostCard().getName());
+            return rock;
+        }
+        if (engine != null) {
+            note(game, "PLAN " + ai.getName() + " starts a draw engine: " + engine.getHostCard().getName());
+            return engine;
+        }
+        if (commander != null) {
+            note(game, "PLAN " + ai.getName() + " casts commander: " + commander.getHostCard().getName());
+            return commander;
+        }
+        return null;
+    }
+
+    /** Cheap card-draw engines cEDH decks deploy early: the cards that win the long game. */
+    static final java.util.Set<String> ENGINES = java.util.Set.of("Mystic Remora", "Rhystic Study", "Esper Sentinel",
+            "Necropotence", "Sylvan Library", "Phyrexian Arena", "Trouble in Pairs");
+
+    static final String BREACH = "Underworld Breach";
+    static final String LED = "Lion's Eye Diamond";
+    static final String FREEZE = "Brain Freeze";
+    static final String ORACLE = "Thassa's Oracle";
+
+    private static boolean controls(final Player ai, final String name) {
+        for (final Card c : ai.getCardsIn(ZoneType.Battlefield)) {
+            if (name.equals(c.getName())) {
+                return true;
+            }
+        }
+        return false;
+    }
+
+    private static boolean has(final Player ai, final String name, final ZoneType... zones) {
+        for (final ZoneType z : zones) {
+            for (final Card c : ai.getCardsIn(z)) {
+                if (name.equals(c.getName())) {
+                    return true;
+                }
+            }
+        }
+        return false;
+    }
+
+    /** A playable spell of this name from hand or graveyard (escape under Breach). */
+    private static SpellAbility castOf(final Player ai, final List<SpellAbility> candidates, final String name) {
+        for (final SpellAbility sa : candidates) {
+            final Card host = sa == null ? null : sa.getHostCard();
+            if (host == null || !sa.isSpell() || !name.equals(host.getName())
+                    || !(host.isInZone(ZoneType.Hand) || host.isInZone(ZoneType.Graveyard))) {
+                continue;
+            }
+            if (playable(ai, sa)) {
+                return sa;
+            }
+        }
+        return null;
+    }
+
+    /**
+     * The Underworld Breach line: Breach first when Lion's Eye Diamond and Brain Freeze are at hand, then loop
+     * Diamond and Brain Freeze from the graveyard, milling yourself for fuel and then the table (or yourself out
+     * for Thassa's Oracle).
+     */
+    static SpellAbility breachLine(final Player ai, final List<SpellAbility> candidates) {
+        final Game game = ai.getGame();
+        final boolean freezeNear = has(ai, FREEZE, ZoneType.Hand, ZoneType.Graveyard);
+        if (!controls(ai, BREACH)) {
+            if (freezeNear && has(ai, LED, ZoneType.Hand, ZoneType.Graveyard, ZoneType.Battlefield)
+                    && has(ai, BREACH, ZoneType.Hand) && ai.getCardsIn(ZoneType.Graveyard).size() >= 3) {
+                final SpellAbility b = castOf(ai, candidates, BREACH);
+                if (b != null) {
+                    note(game, "PLAN " + ai.getName() + " sets up the Underworld Breach loop");
+                    return b;
+                }
+            }
+            return null;
+        }
+        if (ai.getCardsIn(ZoneType.Library).size() <= 2 && !ai.cantWin()) {
+            SpellAbility o = castOf(ai, candidates, ORACLE);
+            if (o == null && has(ai, ORACLE, ZoneType.Graveyard) && crackLed(ai)) {
+                o = castOf(ai, candidates, ORACLE);
+            }
+            if (o != null) {
+                note(game, "PLAN " + ai.getName() + " escapes Thassa's Oracle with an empty library");
+                return o;
+            }
+        }
+        if (!freezeNear) {
+            return null;
+        }
+        if (!controls(ai, LED)) {
+            final SpellAbility l = castOf(ai, candidates, LED);
+            if (l != null) {
+                return l;
+            }
+        }
+        SpellAbility f = castOf(ai, candidates, FREEZE);
+        if (f == null && has(ai, FREEZE, ZoneType.Graveyard) && !has(ai, FREEZE, ZoneType.Hand)
+                && ai.getCardsIn(ZoneType.Graveyard).size() >= 4 && crackLed(ai)) {
+            f = castOf(ai, candidates, FREEZE);
+        }
+        if (f != null) {
+            final Player t = breachMillTarget(ai, f);
+            if (t != null) {
+                f.resetTargets();
+                f.getTargets().add(t);
+                note(game, "LINE " + ai.getName() + " Breach loop: Brain Freeze at " + t.getName()
+                        + " (storm " + game.getStack().getSpellsCastThisTurn().size() + ")");
+                return f;
+            }
+        }
+        return null;
+    }
+
+    static final java.util.Set<String> HAND_TUTORS = new java.util.HashSet<>(java.util.Arrays.asList(
+            "Demonic Tutor", "Grim Tutor", "Diabolic Tutor", "Beseech the Mirror"));
+    static final java.util.Set<String> WINNERS = new java.util.HashSet<>(java.util.Arrays.asList(
+            ORACLE, "Laboratory Maniac", "Jace, Wielder of Mysteries"));
+    static final java.util.Set<String> EMPTIERS = new java.util.HashSet<>(java.util.Arrays.asList(
+            "Demonic Consultation", "Tainted Pact"));
+
+    private static boolean anyIn(final Player ai, final java.util.Set<String> names, final ZoneType zone) {
+        for (final Card c : ai.getCardsIn(zone)) {
+            if (names.contains(c.getName())) {
+                return true;
+            }
+        }
+        return false;
+    }
+
+    /** The half of the Oracle line a tutor should find now, or null when it shouldn't: the other half is in hand. */
+    static String missingOracleHalf(final Player ai) {
+        final boolean winner = anyIn(ai, WINNERS, ZoneType.Hand);
+        final boolean emptier = anyIn(ai, EMPTIERS, ZoneType.Hand);
+        if (winner == emptier || ai.cantWin() || ai.getCardsIn(ZoneType.Library).size() <= 7) {
+            return null;
+        }
+        if (winner) {
+            return anyIn(ai, java.util.Collections.singleton("Demonic Consultation"), ZoneType.Library)
+                    ? "Demonic Consultation" : "Tainted Pact";
+        }
+        return ORACLE;
+    }
+
+    /**
+     * Demonic Tutor (or the like) for the missing half of Thassa's Oracle with Consultation or Pact, when there is
+     * mana left to cast both halves this turn.
+     */
+    static SpellAbility tutorForOracle(final Player ai, final List<SpellAbility> candidates) {
+        final String want = missingOracleHalf(ai);
+        if (want == null || !anyIn(ai, java.util.Collections.singleton(want), ZoneType.Library)) {
+            return null;
+        }
+        for (final SpellAbility sa : candidates) {
+            final Card host = sa == null ? null : sa.getHostCard();
+            if (host == null || !sa.isSpell() || !host.isInZone(ZoneType.Hand) || !HAND_TUTORS.contains(host.getName())) {
+                continue;
+            }
+            final int need = host.getCMC() + 2 + (ORACLE.equals(want) ? 1 : 0); // Oracle UU plus the emptier, or the reverse
+            if (forge.ai.ComputerUtilMana.getAvailableManaEstimate(ai) >= need && playable(ai, sa)) {
+                note(ai.getGame(), "PLAN " + ai.getName() + " tutors for " + want + " to win with Thassa's Oracle");
+                return sa;
+            }
+        }
+        return null;
+    }
+
+    /** The card a tutor of this player should take for the Oracle line, or null for the usual choice. */
+    public static Card winTutorPick(final Player decider, final SpellAbility sa, final Iterable<Card> fetchList) {
+        if (!enabled || decider == null || sa == null || !decider.equals(sa.getActivatingPlayer())) {
+            return null;
+        }
+        final String want = missingOracleHalf(decider);
+        if (want == null) {
+            return null;
+        }
+        for (final Card c : fetchList) {
+            if (want.equals(c.getName())) {
+                return c;
+            }
+        }
+        return null;
+    }
+
+    static final java.util.Set<String> LOOP_PIECES = new java.util.HashSet<>(java.util.Arrays.asList(
+            LED, FREEZE, ORACLE, BREACH, "Demonic Consultation", "Tainted Pact"));
+
+    /** The graveyard cards a Breach loop may exile, or null when no loop is running. */
+    public static forge.game.card.CardCollection breachFuel(final Player ai, final forge.game.card.CardCollection options) {
+        if (!enabled || ai == null || !controls(ai, BREACH)) {
+            return null;
+        }
+        final forge.game.card.CardCollection out = new forge.game.card.CardCollection();
+        for (final Card c : options) {
+            if (!LOOP_PIECES.contains(c.getName())) {
+                out.add(c);
+            }
+        }
+        return out;
+    }
+
+    /**
+     * Brain Freeze is a combo piece in a Breach deck: held until Underworld Breach is out, unless one cast already
+     * mills an opponent out.
+     */
+    public static boolean heldForBreach(final Player ai, final SpellAbility sa) {
+        if (!enabled || ai == null || sa == null || sa.getHostCard() == null || !FREEZE.equals(sa.getHostCard().getName())
+                || controls(ai, BREACH)) {
+            return false;
+        }
+        if (!has(ai, BREACH, ZoneType.Hand, ZoneType.Library, ZoneType.Graveyard)) {
+            return false;
+        }
+        final int copies = 3 * (ai.getGame().getStack().getSpellsCastThisTurn().size() + 1);
+        for (final Player o : ai.getOpponents()) {
+            if (o.getCardsIn(ZoneType.Library).size() <= copies) {
+                return false;
+            }
+        }
+        return true;
+    }
+
+    /** Sacrifices Lion's Eye Diamond for three blue mana, to keep a Breach loop going. */
+    static boolean crackLed(final Player ai) {
+        for (final Card c : ai.getCardsIn(ZoneType.Battlefield)) {
+            if (!LED.equals(c.getName())) {
+                continue;
+            }
+            for (final SpellAbility ma : c.getManaAbilities()) {
+                ma.setActivatingPlayer(ai);
+                if (ma.getManaPart() != null) {
+                    ma.getManaPart().setExpressChoice("U");
+                }
+                if (ma.canPlay() && forge.ai.ComputerUtil.playNoStack(ai, ma, ai.getGame(), false)) {
+                    note(ai.getGame(), "LINE " + ai.getName() + " Breach loop: cracks Lion's Eye Diamond for blue");
+                    return true;
+                }
+            }
+        }
+        return false;
+    }
+
+    /** Pending mill from Brain Freezes already on the stack, per player. */
+    private static Map<Player, Integer> pendingMill(final Game game) {
+        final Map<Player, Integer> m = new java.util.HashMap<>();
+        for (final SpellAbilityStackInstance si : game.getStack()) {
+            final SpellAbility s = si.getSpellAbility();
+            if (s == null || s.getHostCard() == null || !FREEZE.equals(s.getHostCard().getName()) || s.getTargets() == null) {
+                continue;
+            }
+            for (final Player p : s.getTargets().getTargetPlayers()) {
+                m.merge(p, 3, Integer::sum);
+            }
+        }
+        return m;
+    }
+
+    /**
+     * Who a Brain Freeze (or a copy) should mill while its controller has Underworld Breach out, or null to leave
+     * it to the usual targeting. Fuel first, then yourself out when Thassa's Oracle is at hand, else the table.
+     */
+    public static Player breachMillTarget(final Player ai, final SpellAbility sa) {
+        if (!enabled || ai == null || sa == null || sa.getHostCard() == null
+                || !FREEZE.equals(sa.getHostCard().getName()) || !controls(ai, BREACH)) {
+            return null;
+        }
+        final Map<Player, Integer> pend = pendingMill(ai.getGame());
+        final int myLib = ai.getCardsIn(ZoneType.Library).size() - pend.getOrDefault(ai, 0);
+        final int fuel = ai.getCardsIn(ZoneType.Graveyard).size() + pend.getOrDefault(ai, 0);
+        // with a Thassa's Oracle anywhere but exile, mill yourself out: the Oracle then escapes onto an empty library
+        final boolean oracle = has(ai, ORACLE, ZoneType.Hand, ZoneType.Graveyard, ZoneType.Library) && !ai.cantWin();
+        if (myLib > 0 && sa.canTarget(ai) && (fuel < 30 || oracle)) {
+            return ai;
+        }
+        Player best = null;
+        int bestLeft = 0;
+        for (final Player o : ai.getOpponents()) {
+            final int left = o.getCardsIn(ZoneType.Library).size() - pend.getOrDefault(o, 0);
+            if (left > bestLeft && sa.canTarget(o)) {
+                best = o;
+                bestLeft = left;
+            }
+        }
+        if (best != null) {
+            return best;
+        }
+        return sa.canTarget(ai) ? ai : null;
+    }
+
+    private static boolean playable(final Player ai, final SpellAbility sa) {
+        sa.setActivatingPlayer(ai);
+        return sa.canPlay() && ComputerUtilCost.canPayCost(sa, ai, false);
+    }
+
+    /**
+     * Learned mulligan model (from cedh-sim train): a logistic score of the hand's features. Keep when the predicted
+     * chance to win with this hand is at least the chance the model expects after one more mulligan.
+     * Loaded from a properties file given to the simulator with -model; null: Forge's own rule decides.
+     */
+    public static volatile java.util.Properties mulliganModel = null;
+    /** When set, only this player uses the learned model (for testing a model on one seat). */
+    public static volatile String modelOnly = null;
+
+    public static void loadModel(final String path) {
+        if (path == null) {
+            mulliganModel = null;
+            return;
+        }
+        final java.util.Properties p = new java.util.Properties();
+        try (java.io.Reader r = java.nio.file.Files.newBufferedReader(java.nio.file.Path.of(path))) {
+            p.load(r);
+            mulliganModel = p;
+        } catch (final java.io.IOException e) {
+            System.out.println("Cannot read model " + path + ": " + e);
+        }
+    }
+
+    private static java.util.Set<String> cardSet(final java.util.Properties m, final String key) {
+        final java.util.Set<String> out = new java.util.HashSet<>();
+        for (final String s : m.getProperty(key, "").split("\\|")) {
+            if (!s.isBlank()) {
+                out.add(s.trim());
+            }
+        }
+        return out;
+    }
+
+    private static double w(final java.util.Properties m, final String k) {
+        try {
+            return Double.parseDouble(m.getProperty(k, "0"));
+        } catch (final NumberFormatException e) {
+            return 0;
+        }
+    }
+
+    /** The model's estimated chance to win with a hand of these cards kept at this size. */
+    static double handScore(final java.util.Properties m, final Iterable<Card> hand, final int size) {
+        final java.util.Set<String> fast = cardSet(m, "cards.fast");
+        final java.util.Set<String> tutor = cardSet(m, "cards.tutor");
+        final java.util.Set<String> inter = cardSet(m, "cards.interaction");
+        final java.util.Set<String> combo = cardSet(m, "cards.combo");
+        final java.util.Set<String> draw = cardSet(m, "cards.draw");
+        int lands = 0, nf = 0, nt = 0, ni = 0, nc = 0, nd = 0;
+        for (final Card c : hand) {
+            final String n = c.getName();
+            if (c.isLand()) {
+                lands++;
+            }
+            nf += fast.contains(n) ? 1 : 0;
+            nt += tutor.contains(n) ? 1 : 0;
+            ni += inter.contains(n) ? 1 : 0;
+            nc += combo.contains(n) ? 1 : 0;
+            nd += draw.contains(n) ? 1 : 0;
+        }
+        final double mana = lands + nf;
+        double z = w(m, "bias") + w(m, "w.lands") * lands + w(m, "w.lands2") * lands * lands
+                + w(m, "w.fast") * nf + w(m, "w.tutor") * nt + w(m, "w.interaction") * ni + w(m, "w.combo") * nc
+                + w(m, "w.draw") * nd + w(m, "w.size") * size + w(m, "w.mana_ok") * (mana >= 3 && mana <= 5 ? 1 : 0);
+        return 1.0 / (1.0 + Math.exp(-z));
+    }
+
+    /** Keep or mulligan by the learned model; null when no model is loaded (Forge's own rule decides). */
+    public static Boolean learnedKeep(final Player ai, final Iterable<Card> hand, final int cardsToReturn) {
+        final java.util.Properties m = mulliganModel;
+        if (!enabled || m == null || ai == null || modelOnly != null && !modelOnly.equals(ai.getName())) {
+            return null;
+        }
+        final int size = 7 - cardsToReturn;
+        if (size <= Integer.parseInt(m.getProperty("min_keep", "5"))) {
+            return true;
+        }
+        final double p = handScore(m, hand, size);
+        // what a mulligan is worth: the average chance of a hand one card smaller (the first mulligan is free,
+        // which the caller already reflects in cardsToReturn)
+        final int calls = MULL_CALLS.getOrDefault(ai, 0);
+        MULL_CALLS.put(ai, calls + 1);
+        // the first mulligan of a multiplayer game is free: shipping the first seven gives another seven
+        final double next = w(m, "expect." + (size == 7 && calls == 0 ? 7 : Math.max(1, size - 1)));
+        final boolean keep = p >= next;
+        note(ai.getGame(), "MULL " + ai.getName() + (keep ? " keeps " : " ships ") + size + " (model "
+                + String.format(java.util.Locale.ROOT, "%.2f vs %.2f", p, next) + ")");
+        return keep;
+    }
+
+    private static final Map<Player, Integer> SEVEN_LOOKS = Collections.synchronizedMap(new WeakHashMap<>());
+
+    /**
+     * Whether this is a seven-card look after the free first mulligan is used: shipping it costs a card, so the hand
+     * is weighed against a six-card hand's bar (cEDH players keep most functional sevens here).
+     */
+    public static boolean secondSeven(final Player ai, final int cardsToReturn) {
+        if (!enabled || ai == null || cardsToReturn != 0) {
+            return false;
+        }
+        final int looks = SEVEN_LOOKS.getOrDefault(ai, 0);
+        SEVEN_LOOKS.put(ai, looks + 1);
+        return looks >= 1;
+    }
+
+    private static final Map<Player, Integer> MULL_CALLS = Collections.synchronizedMap(new WeakHashMap<>());
+
+    private static final Map<Game, List<String>> JOURNAL = Collections.synchronizedMap(new WeakHashMap<>());
+
+    public static void resetJournal(final Game game) {
+        JOURNAL.put(game, Collections.synchronizedList(new ArrayList<>()));
+    }
+
+    public static List<String> journal(final Game game) {
+        final List<String> j = JOURNAL.get(game);
+        return j == null ? Collections.emptyList() : new ArrayList<>(j);
+    }
+
+    public static void note(final Game game, final String line) {
+        final List<String> j = JOURNAL.get(game);
+        if (j != null) {
+            final String entry = "T" + game.getPhaseHandler().getTurn() + " " + line;
+            synchronized (j) {
+                if (!j.isEmpty() && j.get(j.size() - 1).equals(entry)) {
+                    return; // the same step noted again (a repeated choice): once is enough
+                }
+            }
+            j.add(entry);
+        }
+    }
+}
