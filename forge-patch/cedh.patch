+STRIPMINE_MIN_LANDS_OTB_FOR_NO_TEMPO_CHECK=6
+STRIPMINE_MAX_LANDS_TO_ATTEMPT_MANALOCKING=3
+STRIPMINE_HIGH_PRIORITY_ON_SKIPPED_LANDDROP=true
+
+# The default chance to use the token-generation abilities
