+MOJHOSTO_CHANCE_TO_USE_JHOIRA_COPY_INSTANT=20
+
+# Master toggle for the following options setting the default AIPreference:SacCost handling.
+SACRIFICE_DEFAULT_PREF_ENABLE=false
