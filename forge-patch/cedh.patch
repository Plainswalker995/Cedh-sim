+    /** How the winner won, from the outcomes. */
+    static String winType(final Game game, final Player winner) {
+        if (winner == null) {
+            return "draw";
+        }
+        final PlayerOutcome wo = winner.getOutcome();
+        if (wo != null && wo.altWinSourceName != null) {
+            return "alt-win: " + wo.altWinSourceName;
+        }
+        final Map<String, Integer> reasons = new LinkedHashMap<>();
+        for (final Player p : game.getRegisteredPlayers()) {
+            if (p == winner || p.getOutcome() == null || p.getOutcome().lossState == null) {
+                continue;
+            }
+            final GameLossReason r = p.getOutcome().lossState;
+            final String label = switch (r) {
+                case LifeReachedZero -> "damage/life loss";
+                case CommanderDamage -> "commander damage";
+                case Milled -> "milled (drew from empty library)";
+                case Poisoned -> "poison";
+                case SpellEffect -> "lose-the-game effect" + (p.getOutcome().loseConditionSpell != null
+                        ? " (" + p.getOutcome().loseConditionSpell + ")" : "");
+                case Conceded -> "conceded";
+                case OpponentWon -> "opponent won";
+                default -> r.name();
+            };
+            reasons.merge(label, 1, Integer::sum);
+        }
+        return reasons.isEmpty() ? "last player standing" : String.join(" + ", reasons.keySet());
+    }
+
+    static String json(final String s) {
+        if (s == null) {
+            return "null";
+        }
+        final StringBuilder b = new StringBuilder("\"");
+        for (final char c : s.toCharArray()) {
+            switch (c) {
+                case '"' -> b.append("\\\"");
+                case '\\' -> b.append("\\\\");
+                case '\n' -> b.append("\\n");
+                case '\r' -> { }
+                case '\t' -> b.append(' ');
+                default -> b.append(c);
+            }
+        }
+        return b.append('"').toString();
+    }
+
+    static String jsonList(final Collection<String> l) {
+        final StringBuilder b = new StringBuilder("[");
+        boolean first = true;
+        for (final String s : l) {
+            b.append(first ? "" : ",").append(json(s));
+            first = false;
+        }
+        return b.append(']').toString();
+    }
