+    private static final Pattern CAST = Pattern.compile("^(.+?) cast (.+?)(?: targeting .*)?$");
+    private static final Pattern LAND = Pattern.compile("^(.+?) played (.+?)(?: \\(\\d+\\))?$");
+
+    private static void report(final Game game, final Recorder rec, final int gameNo, final long seed, final long ms,
+            final boolean timedOut, final String error, final Path out, final String heroName) throws IOException {
+        Player winner = null;
+        if (!rec.roundCapHit && !timedOut && !game.getOutcome().isDraw() && game.getOutcome().getWinningLobbyPlayer() != null) {
+            final String wname = game.getOutcome().getWinningLobbyPlayer().getName();
+            for (final Player pl : game.getRegisteredPlayers()) {
+                if (pl.getName().equals(wname)) {
+                    winner = pl;
+                }
+            }
+        }
+        final int turn = game.getPhaseHandler().getTurn();
+        final int seatsN = game.getRegisteredPlayers().size();
+        final int winnerTurns = winner == null ? 0 : rec.turnsTaken.getOrDefault(winner.getName(), 0);
+        final String how = rec.roundCapHit ? "round cap (draw)" : timedOut ? "time limit (draw)"
+                : (error != null ? "engine error (draw)" : winType(game, winner));
+        final List<String> journal = CedhPilot.journal(game);
+        final List<GameLogEntry> log = new ArrayList<>(game.getGameLog().getLogEntries(null));
+        Collections.reverse(log);
+        final List<String> seats = new ArrayList<>();
+        for (final Player pl : game.getRegisteredPlayers()) {
+            seats.add(pl.getName());
+        }
+        // seats in turn order: Forge picks who goes first, so the list starts at the starting player
+        final Player starter = game.getStartingPlayer();
+        final int at = starter == null ? -1 : seats.indexOf(starter.getName());
+        if (at > 0) {
+            Collections.rotate(seats, -at);
+        }
+
+        // per-player stats from the log
+        final Map<String, List<String>> cast = new LinkedHashMap<>();
+        final Map<String, List<String>> lands = new LinkedHashMap<>();
+        final Map<String, Integer> mulligans = new LinkedHashMap<>();
+        for (final String s : seats) {
+            cast.put(s, new ArrayList<>());
+            lands.put(s, new ArrayList<>());
+            mulligans.put(s, 0);
+        }
+        for (final GameLogEntry e : log) {
+            final String m = e.message();
+            if (e.type() == GameLogEntryType.STACK_ADD) {
+                final Matcher mm = CAST.matcher(m);
+                if (mm.matches() && cast.containsKey(mm.group(1))) {
+                    cast.get(mm.group(1)).add(mm.group(2).replaceAll(" \\(\\d+\\)$", ""));
+                }
+            } else if (e.type() == GameLogEntryType.LAND) {
+                final Matcher mm = LAND.matcher(m);
+                if (mm.matches() && lands.containsKey(mm.group(1))) {
+                    lands.get(mm.group(1)).add(mm.group(2));
+                }
+            } else if (e.type() == GameLogEntryType.MULLIGAN && m.contains("mulliganed")) {
+                for (final String s : seats) {
+                    if (m.startsWith(s + " ")) {
+                        mulligans.merge(s, 1, Integer::sum);
+                    }
+                }
+            }
+        }
+        final Map<String, List<String>> countered = rec.countered();
+
+        // ---------- the play-by-play file
+        final StringBuilder md = new StringBuilder();
+        md.append("# Game ").append(gameNo).append(": ").append(String.join(" vs ", seats)).append("\n\n");
+        md.append("## Summary\n\n");
+        md.append("- **Winner:** ").append(winner == null ? "nobody (draw)" : winner.getName()).append('\n');
+        md.append("- **How:** ").append(how).append('\n');
+        if (winner != null) {
+            md.append("- **When:** the winner's turn ").append(winnerTurns).append(" (game turn ").append(turn)
+              .append(", round ").append((turn + seatsN - 1) / seatsN).append(")\n");
+        }
+        if (heroName != null) {
+            final List<String> opps = new ArrayList<>(seats);
+            opps.remove(heroName);
+            md.append("- **Your seat:** ").append(seats.indexOf(heroName) + 1).append(" of ").append(seatsN).append('\n');
+            md.append("- **Opponents drawn:** ").append(String.join(", ", opps)).append('\n');
+        }
+        md.append("- **Turn order:** ").append(String.join(", ", seats)).append('\n');
+        md.append("- **Play styles:** ").append(String.join(", ", seatStyles).replace("=CedhPatient", ": patient")
+                .replace("=CedhAggro", ": aggressive").replace("=Cedh", ": balanced")).append('\n');
+        final List<String> mullTxt = new ArrayList<>();
+        for (final String s : seats) {
+            mullTxt.add(s + " " + mulligans.get(s));
+        }
+        md.append("- **Mulligans:** ").append(String.join(", ", mullTxt)).append('\n');
+        if (!countered.isEmpty()) {
+            final List<String> ct = new ArrayList<>();
+            for (final Map.Entry<String, List<String>> e : countered.entrySet()) {
+                ct.add(e.getKey() + ": " + String.join(", ", e.getValue()));
+            }
+            md.append("- **Spells countered or fizzled:** ").append(String.join("; ", ct)).append('\n');
+        }
+        md.append("- **Length:** ").append(ms / 1000).append(" s of computer time; seed ").append(seed).append('\n');
+        if (error != null) {
+            md.append("- **Engine error:** ").append(error).append('\n');
+        }
+        final List<String> keyPlays = keyPlays(log, journal);
+        if (!keyPlays.isEmpty()) {
+            md.append("\n### Key plays\n\n");
+            for (final String kp : keyPlays) {
+                md.append("- ").append(kp).append('\n');
+            }
+        }
+        md.append("\n## Play by play\n\n");
+        if (rec.openingText != null) {
+            md.append("### Opening hands (after mulligans)\n\n").append(rec.openingText).append('\n');
+        }
+        for (final GameLogEntry e : log) {
+            switch (e.type()) {
+                case TURN -> {
+                    md.append("\n### ").append(e.message()).append("\n\n");
+                    final Integer tn = turnNumber(e.message());
+                    if (tn != null && tn > 1 && rec.handsText.containsKey(tn)) {
+                        md.append(rec.handsText.get(tn)).append('\n');
+                    }
+                }
+                case PHASE, MANA, PLAYER_CONTROL, MULLIGAN, MATCH_RESULTS -> { }
+                default -> md.append("- ").append(e.message().replace("\n", " ")).append('\n');
+            }
+        }
+        if (!journal.isEmpty()) {
+            md.append("\n## cEDH pilot notes\n\n");
+            for (final String j : journal) {
+                md.append("- ").append(j).append('\n');
+            }
+        }
+        md.append("\n## Final board\n\n");
+        for (final Player pl : game.getRegisteredPlayers()) {
+            md.append("- **").append(pl.getName()).append("** life ").append(pl.getLife()).append(", battlefield: ")
+              .append(names(pl.getCardsIn(ZoneType.Battlefield))).append("; hand: ").append(names(pl.getCardsIn(ZoneType.Hand)))
+              .append('\n');
+        }
+        final Path file = out.resolve("games").resolve(String.format("game-%03d.md", gameNo));
+        Files.writeString(file, md.toString(), StandardCharsets.UTF_8);
+
+        // ---------- JSON line
+        final StringBuilder js = new StringBuilder("{");
+        js.append("\"game\":").append(gameNo).append(",\"seed\":").append(seed)
+          .append(",\"players\":").append(jsonList(seats))
+          .append(",\"hero\":").append(json(heroName))
+          .append(",\"styles\":").append(json(String.join(", ", seatStyles)))
+          .append(",\"round_cap\":").append(roundCap)
+          .append(",\"winner\":").append(json(winner == null ? null : winner.getName()))
+          .append(",\"how\":").append(json(how))
+          .append(",\"game_turn\":").append(turn)
+          .append(",\"winner_turns\":").append(winnerTurns)
+          .append(",\"seconds\":").append(ms / 1000)
+          .append(",\"timed_out\":").append(timedOut)
+          .append(",\"error\":").append(json(error))
+          .append(",\"key_plays\":").append(jsonList(keyPlays))
+          .append(",\"journal\":").append(jsonList(journal))
+          .append(",\"stats\":{");
+        boolean first = true;
+        for (final Player pl : game.getRegisteredPlayers()) {
+            final String s = pl.getName();
+            final List<String> endHand = new ArrayList<>();
+            for (final Card c : pl.getCardsIn(ZoneType.Hand)) {
+                endHand.add(c.getName());
+            }
+            final List<String> openHand = rec.opening == null ? List.of() : rec.opening.getOrDefault(s, List.of());
+            js.append(first ? "" : ",").append(json(s)).append(":{")
+              .append("\"seat\":").append(seats.indexOf(s) + 1)
+              .append(",\"mulligans\":").append(mulligans.get(s))
+              .append(",\"opening_hand\":").append(jsonList(openHand))
+              .append(",\"seen\":").append(jsonList(rec.seen.getOrDefault(s, new LinkedHashSet<>())))
+              .append(",\"cast\":").append(jsonList(cast.get(s)))
+              .append(",\"lands\":").append(jsonList(lands.get(s)))
+              .append(",\"countered\":").append(jsonList(countered.getOrDefault(s, List.of())))
+              .append(",\"end_hand\":").append(jsonList(endHand))
+              .append(",\"battlefield\":").append(jsonList(Arrays.asList(names(pl.getCardsIn(ZoneType.Battlefield)).split(", "))))
+              .append(",\"turns_taken\":").append(rec.turnsTaken.getOrDefault(s, 0))
+              .append(",\"life\":").append(pl.getLife())
+              .append(",\"loss\":").append(json(pl.getOutcome() == null || pl.getOutcome().lossState == null ? null
+                      : pl.getOutcome().lossState.name()))
+              .append('}');
+            first = false;
+        }
+        js.append("},\"file\":").append(json(file.toAbsolutePath().toString()))
+          .append(",\"finished\":").append(json(Instant.now().toString())).append("}\n");
+        Files.writeString(out.resolve("results.jsonl"), js.toString(), StandardCharsets.UTF_8,
+                StandardOpenOption.CREATE, StandardOpenOption.APPEND);
+
+        System.out.println("GAME " + gameNo + " | " + String.join(" / ", seats) + " | winner: "
+                + (winner == null ? "draw" : winner.getName()) + " | " + how
+                + (winner != null ? " | winner's turn " + winnerTurns : "") + " | " + (ms / 1000) + " s");
+        System.out.flush();
+    }
