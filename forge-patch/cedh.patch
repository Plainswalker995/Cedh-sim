+    /**
+     * Test scenarios, applied when the first turn begins: lines "p0 hand: A; B" or "p1 battlefield: C; D", where pN is
+     * the Nth player in turn order. Each card comes from that player's library when it is there, or is made new.
+     */
+    static void applyScenario(final Game game, final List<String> lines, final String heroName) {
+        final Pattern re = Pattern.compile("^(p\\d|hero)\\s+(hand|battlefield|graveyard|top)\\s*:\\s*(.*)$", Pattern.CASE_INSENSITIVE);
+        for (final String raw : lines) {
+            final Matcher m = re.matcher(raw.trim());
+            if (!m.matches()) {
+                continue;
+            }
+            Player p = null;
+            if (m.group(1).equalsIgnoreCase("hero")) {
+                for (final Player x : game.getPlayers()) {
+                    if (x.getName().equals(heroName)) {
+                        p = x;
+                    }
+                }
+            } else {
+                final int idx = Integer.parseInt(m.group(1).substring(1));
+                if (idx < game.getPlayers().size()) {
+                    p = game.getPlayers().get(idx);
+                }
+            }
+            if (p == null) {
+                continue;
+            }
+            final String zone = m.group(2).toLowerCase(Locale.ROOT);
+            for (final String nm : m.group(3).split(";")) {
+                final String name = nm.trim();
+                if (name.isEmpty()) {
+                    continue;
+                }
+                Card c = null;
+                for (final Card x : p.getCardsIn(ZoneType.Library)) {
+                    if (x.getName().equals(name)) {
+                        c = x;
+                        break;
+                    }
+                }
+                if (c == null) {
+                    final PaperCard pc = FModel.getMagicDb().getCommonCards().getCard(name);
+                    if (pc == null) {
+                        System.out.println("Scenario: unknown card " + name);
+                        continue;
+                    }
+                    c = Card.fromPaperCard(pc, p);
+                    c.setGameTimestamp(game.getNextTimestamp());
+                    p.getZone(ZoneType.Library).add(c);
+                }
+                switch (zone) {
+                    case "hand" -> game.getAction().moveToHand(c, null);
+                    case "battlefield" -> game.getAction().moveToPlay(c, p, null, null);
+                    case "graveyard" -> game.getAction().moveToGraveyard(c, null);
+                    default -> game.getAction().moveToLibrary(c, 0, null);
+                }
+            }
+        }
+    }
+
+    private static void playOne(final Match match, final int gameNo, final long seed, final String mc, final int timeout,
+            final String scenarioText, final Path out, final String heroName) {
+        final Game game = match.createGame();
+        game.setNoGUIUser();
+        game.AI_FLAT_MONTE_CARLO = !"off".equalsIgnoreCase(mc);
+        game.AI_FLAT_MONTE_CARLO_MAX = "max".equalsIgnoreCase(mc);
+        final Recorder rec = new Recorder(game);
+        rec.heroName = heroName;
+        if (scenarioText != null) {
+            rec.scenario = Arrays.asList(scenarioText.split("\n"));
+        }
+        game.subscribeToEvents(rec);
+        CedhPilot.resetJournal(game);
+        final long t0 = System.currentTimeMillis();
+        boolean timedOut = false;
+        String error = null;
+        try {
+            TimeLimitedCodeBlock.runWithTimeout(() -> match.startGame(game), timeout, TimeUnit.SECONDS);
+        } catch (final TimeoutException e) {
+            timedOut = true;
+        } catch (final Exception | StackOverflowError e) {
+            error = e.toString();
+        } finally {
+            if (!game.isGameOver()) {
+                game.setGameOver(GameEndReason.Draw);
+            }
+        }
+        final long ms = System.currentTimeMillis() - t0;
+        try {
+            report(game, rec, gameNo, seed, ms, timedOut, error, out, heroName);
+        } catch (final IOException e) {
+            System.out.println("Could not write results: " + e);
+        }
+    }
