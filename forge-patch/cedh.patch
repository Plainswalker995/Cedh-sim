+
+/**
+ * cEDH batch simulator: four-player Commander games between AI pilots, under Forge's rules engine.
+ * Two ways to pick the pod:
+ *   fixed:  -d a.dck b.dck c.dck d.dck           (the same four decks every game; -rotate turns the seats)
+ *   pool:   -hero mine.dck -pool dir [-k 3]      (your deck plus k decks drawn at random from dir each game,
+ *                                                 never two decks with the same commander, seats shuffled)
+ * The pod and the seat order come from the game's seed, so a game can be replayed and a swap test plays the
+ * same pods and seats with both versions of a deck.
+ * For every game, as soon as it ends: one line on the console, a JSON line in results.jsonl and a full
+ * play-by-play (every player's hand at the start of each turn, every spell, trigger, combat and life change)
+ * in games/game-NNN.md.
+ */
+public final class CedhSim {
+    private CedhSim() { }
+
+    /** Turns per player before the game is called a draw (0: no cap). */
+    static int roundCap = 0;
+    static final String[] STYLES = { "CedhPatient", "Cedh", "Cedh", "CedhAggro" };
+    /** Seat styles of the game being set up, for the report. */
+    static final List<String> seatStyles = new ArrayList<>();
+
+    static final class Recorder {
+        final Game game;
+        final Map<Integer, Map<String, List<String>>> hands = new HashMap<>();
+        final Map<Integer, String> handsText = new HashMap<>();
+        final Map<String, Integer> turnsTaken = new LinkedHashMap<>();
+        final Map<String, LinkedHashSet<String>> seen = new HashMap<>();
+        final Map<Integer, String[]> casts = new LinkedHashMap<>(); // sa id -> {player, card}
+        final Set<Integer> resolved = new HashSet<>();
+        final Set<Integer> removed = new HashSet<>();
+        Map<String, List<String>> opening;
+        String openingText;
+        List<String> scenario;
+        boolean scenarioApplied;
+        boolean roundCapHit;
+        String heroName;
+
+        Recorder(final Game game) { this.game = game; }
+
+        @Subscribe
+        public void receive(final GameEvent ev) {
+            if (ev instanceof GameEventSpellAbilityCast c && c.sa() != null && c.sa().getHostCard() != null) {
+                if (!c.sa().isSpell()) {
+                    return;
+                }
+                final String who = c.si() == null || c.si().getActivatingPlayer() == null ? "?"
+                        : c.si().getActivatingPlayer().getName();
+                casts.put(c.sa().getId(), new String[] {who, c.sa().getHostCard().getName()});
+                return;
+            }
+            if (ev instanceof GameEventSpellResolved r && r.spell() != null) {
+                resolved.add(r.spell().getId());
+                return;
+            }
+            if (ev instanceof GameEventSpellRemovedFromStack r && r.sa() != null) {
+                removed.add(r.sa().getId());
+                return;
+            }
+            if (!(ev instanceof GameEventTurnBegan tb)) {
+                return;
+            }
+            if (scenario != null && !scenarioApplied) {
+                scenarioApplied = true;
+                applyScenario(game, scenario, heroName);
+            }
+            if (roundCap > 0 && turnsTaken.getOrDefault(tb.turnOwner().getName(), 0) >= roundCap && !game.isGameOver()) {
+                // tournament round over: the game is a draw, as at a real event when time and extra turns run out
+                roundCapHit = true;
+                game.setGameOver(GameEndReason.Draw);
+                return;
+            }
+            turnsTaken.merge(tb.turnOwner().getName(), 1, Integer::sum);
+            final Map<String, List<String>> snap = new LinkedHashMap<>();
+            final StringBuilder sb = new StringBuilder();
+            for (final Player p : game.getPlayers()) {
+                if (p.hasLost()) {
+                    continue;
+                }
+                final List<String> h = new ArrayList<>();
+                for (final Card c : p.getCardsIn(ZoneType.Hand)) {
+                    h.add(c.getName());
+                }
+                snap.put(p.getName(), h);
+                seen.computeIfAbsent(p.getName(), k -> new LinkedHashSet<>()).addAll(h);
+                sb.append("- **").append(p.getName()).append("** (").append(p.getLife()).append(" life, library ")
+                  .append(p.getCardsIn(ZoneType.Library).size()).append(") hand: ")
+                  .append(h.isEmpty() ? "(empty)" : String.join(", ", h)).append('\n');
+            }
+            if (opening == null) {
+                opening = snap;
+                openingText = sb.toString();
+            }
+            hands.put(tb.turnNumber(), snap);
+            handsText.put(tb.turnNumber(), sb.toString());
+        }
+
+        /** Spells that left the stack without resolving: countered (or fizzled), by player. */
+        Map<String, List<String>> countered() {
+            final Map<String, List<String>> out = new HashMap<>();
+            for (final Map.Entry<Integer, String[]> e : casts.entrySet()) {
+                if (removed.contains(e.getKey()) && !resolved.contains(e.getKey())) {
+                    out.computeIfAbsent(e.getValue()[0], k -> new ArrayList<>()).add(e.getValue()[1]);
+                }
+            }
+            return out;
+        }
+    }
+
+    static String names(final Iterable<Card> cards) {
+        final List<String> out = new ArrayList<>();
+        for (final Card c : cards) {
+            out.add(c.getName());
+        }
+        return out.isEmpty() ? "(empty)" : String.join(", ", out);
+    }
+
+    static Set<String> commanders(final Deck d) {
+        final Set<String> out = new TreeSet<>();
+        if (d.has(DeckSection.Commander)) {
+            for (final PaperCard pc : d.get(DeckSection.Commander).toFlatList()) {
+                out.add(pc.getName());
+            }
+        }
+        return out;
+    }
+
+    public static void run(final String[] args) {
+        FModel.initialize(null, null);
+        final Map<String, List<String>> p = parse(args);
+        final boolean poolMode = p.containsKey("hero");
+        if (!poolMode && (!p.containsKey("d") || p.get("d").size() < 2)) {
+            System.out.println("Usage: cedh -hero mine.dck -pool dir [-k 3]   or   cedh -D deckdir -d a.dck b.dck c.dck d.dck\n"
+                    + "  [-n games] [-s seed] [-a profile] [-mc on|max|off] [-c seconds] [-o outdir] [-rotate]"
+                    + " [-scenario file] [-start K] [-rounds R]");
+            return;
+        }
+        final String deckDir = p.containsKey("D") ? p.get("D").get(0) : ".";
+        final int n = p.containsKey("n") ? Integer.parseInt(p.get("n").get(0)) : 1;
+        final long seed = p.containsKey("s") ? Long.parseLong(p.get("s").get(0)) : System.nanoTime() % 1000000;
+        final String profile = p.containsKey("a") ? p.get("a").get(0) : "Cedh";
+        final String mc = p.containsKey("mc") ? p.get("mc").get(0) : "on";
+        final int timeout = p.containsKey("c") ? Integer.parseInt(p.get("c").get(0)) : 900;
+        CedhPilot.enabled = !p.containsKey("plainai");
+        CedhPilot.loadModel(p.containsKey("model") ? p.get("model").get(0) : null);
+        final boolean styles = !p.containsKey("nostyles");
+        CedhPilot.imperfection = p.containsKey("slip") ? Double.parseDouble(p.get("slip").get(0)) : 0.03;
+        roundCap = p.containsKey("rounds") ? Integer.parseInt(p.get("rounds").get(0)) : 0;
+        final Path out = Path.of(p.containsKey("o") ? p.get("o").get(0) : "cedh-out");
+        final boolean rotate = p.containsKey("rotate");
+        final int start = p.containsKey("start") ? Integer.parseInt(p.get("start").get(0)) : 1;
+        final int k = p.containsKey("k") ? Integer.parseInt(p.get("k").get(0)) : 3;
+        String scenarioText = null;
+        if (p.containsKey("scenario")) {
+            try {
+                scenarioText = Files.readString(Path.of(p.get("scenario").get(0)));
+            } catch (final IOException e) {
+                System.out.println("Cannot read scenario: " + e);
+                return;
+            }
+        }
+        if (!AiProfileUtil.getProfilesDisplayList().contains(profile)) {
+            System.out.println("Unknown AI profile " + profile + ". Available: " + AiProfileUtil.getProfilesDisplayList());
+            return;
+        }
+        final List<Deck> fixed = new ArrayList<>();
+        Deck hero = null;
+        final List<Deck> pool = new ArrayList<>();
+        final Map<Set<String>, List<Deck>> poolByCmd = new LinkedHashMap<>();
+        final Map<Set<String>, Double> cmdWeight = new LinkedHashMap<>();
+        if (poolMode) {
+            hero = load(new File(p.get("hero").get(0)));
+            if (hero == null) {
+                return;
+            }
+            CedhPilot.modelOnly = p.containsKey("modelhero") ? hero.getName() : null;
+            final Set<String> heroCmd = commanders(hero);
+            final File[] files = new File(p.containsKey("pool") ? p.get("pool").get(0) : "pool")
+                    .listFiles((dir, name) -> name.endsWith(".dck"));
+            final Map<String, Double> fileWeights = new HashMap<>();
+            final Path wf = Path.of(p.containsKey("pool") ? p.get("pool").get(0) : "pool", "weights.tsv");
+            if (Files.exists(wf)) {
+                try {
+                    for (final String line : Files.readAllLines(wf)) {
+                        final String[] parts = line.split("\t");
+                        if (parts.length >= 2 && !line.startsWith("#")) {
+                            try {
+                                fileWeights.put(parts[0].trim(), Double.parseDouble(parts[1].trim()));
+                            } catch (final NumberFormatException ignored) { }
+                        }
+                    }
+                } catch (final IOException e) {
+                    System.out.println("Cannot read " + wf + ": " + e);
+                }
+            }
+            if (files != null) {
+                Arrays.sort(files);
+                for (final File f : files) {
+                    final Deck d = load(f);
+                    if (d != null && !commanders(d).equals(heroCmd)) {
+                        pool.add(d);
+                        final Set<String> cmd = commanders(d);
+                        poolByCmd.computeIfAbsent(cmd, x -> new ArrayList<>()).add(d);
+                        // a commander's weight is its meta share (the largest given for any of its lists), else 1
+                        final double w = fileWeights.getOrDefault(f.getName(), fileWeights.isEmpty() ? 1.0 : 0.1);
+                        cmdWeight.merge(cmd, w, Math::max);
+                    }
+                }
+            }
+            if (pool.size() < k) {
+                System.out.println("The pool has " + pool.size() + " usable decks; need at least " + k);
+                return;
+            }
+        } else {
+            for (final String d : p.get("d")) {
+                final Deck deck = load(new File(d).isAbsolute() ? new File(d) : new File(deckDir, d));
+                if (deck == null) {
+                    return;
+                }
+                fixed.add(deck);
+            }
+        }
+        try {
+            Files.createDirectories(out.resolve("games"));
+        } catch (final IOException e) {
+            throw new RuntimeException(e);
+        }
+        System.out.println("CEDH-SIM " + (poolMode ? hero.getName() + " vs " + k + " random of " + pool.size() + " pool decks"
+                : fixed.size() + " fixed decks") + ", " + n + " games, seed " + seed + ", profile " + profile
+                + ", flat Monte Carlo " + mc + ", output " + out.toAbsolutePath());
+        for (int g = 0; g < n; g++) {
+            final int gameNo = start + g;
+            final long gameSeed = seed * 1000003L + gameNo;
+            final Random pick = new Random(gameSeed ^ 0x5DEECE66DL);
+            final List<Deck> pod = new ArrayList<>();
+            if (poolMode) {
+                // the opponents and the seats depend on the seed and the pool only, not on the hero's list:
+                // a swap test gets the same pods and seats for both versions of the deck
+                // commanders drawn in proportion to their meta share, never two alike (weighted sampling without
+                // replacement: key u^(1/w), largest keys win); then one of that commander's lists at random
+                final List<Set<String>> cmds = new ArrayList<>(poolByCmd.keySet());
+                final Map<Set<String>, Double> keys = new HashMap<>();
+                for (final Set<String> c : cmds) {
+                    keys.put(c, Math.pow(pick.nextDouble(), 1.0 / Math.max(1e-6, cmdWeight.getOrDefault(c, 1.0))));
+                }
+                cmds.sort((a, b) -> Double.compare(keys.get(b), keys.get(a)));
+                final List<Deck> opps = new ArrayList<>();
+                for (final Set<String> c : cmds) {
+                    if (opps.size() >= k) {
+                        break;
+                    }
+                    final List<Deck> lists = poolByCmd.get(c);
+                    opps.add(lists.get(pick.nextInt(lists.size())));
+                }
+                final int heroSeat = pick.nextInt(opps.size() + 1);
+                Collections.shuffle(opps, pick);
+                pod.addAll(opps);
+                pod.add(heroSeat, hero);
+            } else {
+                final int shift = rotate ? g % fixed.size() : 0;
+                for (int i = 0; i < fixed.size(); i++) {
+                    pod.add(fixed.get((i + shift) % fixed.size()));
+                }
+            }
+            MyRandom.setRandom(new Random(gameSeed));
+            seatStyles.clear();
+            final List<RegisteredPlayer> players = new ArrayList<>();
+            final Set<String> usedNames = new HashSet<>();
+            for (int i = 0; i < pod.size(); i++) {
+                final Deck deck = pod.get(i);
+                String name = deck.getName();
+                while (!usedNames.add(name)) {
+                    name = name + "'";
+                }
+                final RegisteredPlayer rp = RegisteredPlayer.forCommander(deck);
+                // play styles vary per seat and game (drawn from the seed): patient, balanced or aggressive
+                final String seatProfile = styles ? STYLES[pick.nextInt(STYLES.length)] : profile;
+                seatStyles.add(name + "=" + seatProfile);
+                rp.setPlayer(GamePlayerUtil.createAiPlayer(name, i, seatProfile));
+                players.add(rp);
+            }
+            final GameRules rules = new GameRules(GameType.Commander);
+            rules.setAppliedVariants(EnumSet.of(GameType.Commander));
+            rules.setSimTimeout(timeout);
+            final Match match = new Match(rules, players, "cEDH sim");
+            playOne(match, gameNo, gameSeed, mc, timeout, scenarioText, out, hero == null ? null : hero.getName());
+        }
+    }
